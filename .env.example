# Copier ce fichier en .env et renseigner les valeurs

# Clé secrète Flask — n'importe quelle chaîne fonctionne, plus elle est longue et aléatoire, plus c'est sécurisé
SECRET_KEY=changer-cette-valeur

# Identifiants de connexion à l'application
APP_USER=admin
APP_PASSWORD=remplacer-par-un-mot-de-passe
